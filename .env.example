# ─────────────────────────────────────────────────────────────────────────────
# Welldone AI Agent Team — Variables d'environnement
# Copier ce fichier en .env pour le développement local
# Pour Railway : configurer ces variables dans Settings > Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# BotFather → /newbot → copier le token
TELEGRAM_BOT_TOKEN=

# Ton user ID Telegram (obtenir via @userinfobot)
TELEGRAM_ALLOWED_USER_ID=8434904512

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modèle à utiliser (défaut: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Google Service Account (GA4 + Search Console) ────────────────────────────
# COMMENT GÉNÉRER :
# 1. Google Cloud Console → IAM & Admin → Service Accounts
# 2. Créer un compte de service → Télécharger la clé JSON
# 3. Aller dans GA4 Admin → Gestion des accès → Ajouter le compte de service (Lecteur)
# 4. Aller dans Search Console → Paramètres → Utilisateurs → Ajouter (Propriétaire restreint)
# 5. Encoder: cat service_account.json | base64 | tr -d '\n' | pbcopy
GOOGLE_SA_JSON_B64=

# ── Google OAuth (Gmail + Calendar + Contacts) ────────────────────────────────
# COMMENT GÉNÉRER :
# 1. Google Cloud Console → Credentials → OAuth 2.0 Client ID
# 2. Activer les APIs: Gmail, Calendar, People
# 3. Depuis ce dossier, lancer le script de génération une fois en local :
#    python scripts/generate_oauth_token.py
# 4. Copier le contenu du fichier token.json généré
# 5. Coller le JSON brut (pas base64) dans cette variable
GOOGLE_OAUTH_JSON=

# ── Notion ────────────────────────────────────────────────────────────────────
# https://www.notion.so/my-integrations → Créer une intégration → Copier le token
NOTION_TOKEN=

# ID de la database Tâches (visible dans l'URL Notion de la base)
NOTION_TASK_DB=bd4cff932b7842b19f7cb748e1abda48

# ID de la database Sources RSS pour la veille
NOTION_SOURCES_DB=10e87f01b8ec4c60a6383d48c7aac4a2

# ── Zoho Books ────────────────────────────────────────────────────────────────
# https://api-console.zoho.ca → Créer une Self Client → Scopes: ZohoBooks.fullaccess.all
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORG_ID=110002477093

# Refresh token (obtenu une fois via OAuth, jamais d'expiration)
# Générer avec: python scripts/generate_zoho_token.py
ZOHO_REFRESH_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Destinataire des rapports automatiques
GMAIL_RECIPIENT=awelldonestudio@gmail.com

# ── Analytics ─────────────────────────────────────────────────────────────────
# ID de la propriété GA4 (visible dans GA4 Admin → Informations sur la propriété)
GA4_PROPERTY_ID=522467276

# ── OpenAI (Agent Voyage) ─────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# Utilisé par l'agent voyage avec GPT-4o + function calling
OPENAI_API_KEY=

# ── SerpAPI (Google Flights) ──────────────────────────────────────────────────
# https://serpapi.com → Dashboard → API Key
# Utilisé par l'agent voyage pour les prix de vols en temps réel
SERPAPI_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Agent Foncier — prospection immobilière Québec
# ─────────────────────────────────────────────────────────────────────────────
# Tout est optionnel : l'agent fonctionne sans aucune de ces variables, mais
# uniquement sur les sources gratuites (ventes pour taxes, SEAO, rôles), soit
# 40 des 100 points de scoring. Voir docs/FONCIER.md.

# ── Stockage ──────────────────────────────────────────────────────────────────
# ⚠️ Railway : le disque est éphémère. Sans volume monté, la base est perdue à
#    chaque redéploiement — donc l'historique des scores et la mémoire des
#    dépenses aussi. Monter un volume et pointer ce chemin dessus.
# FONCIER_DB_PATH=./data/foncier/foncier.db
# FONCIER_CACHE_DIR=./data/foncier/cache

# ── Zonage : aires TOD et zones PPU (35 points de scoring) ───────────────────
# Aires TOD de la CMM — Observatoire du Grand Montréal, « Données géoréférencées »
# https://observatoire.cmm.qc.ca/produits/donnees-georeferencees/
# FONCIER_TOD_POLYGONES_URL=
# FONCIER_TOD_POLYGONES_FICHIER=

# À défaut de polygones : points d'accès au transport structurant (métro, gares,
# REM, SRB) en GeoJSON ou CSV. Les aires sont dérivées par rayon 500 m / 1 km,
# exactement comme la CMM les construit.
# FONCIER_TOD_POINTS_URL=
# FONCIER_TOD_POINTS_FICHIER=

# Zones PPU municipales, GeoJSON, séparées par des virgules.
# FONCIER_PPU_URLS=

# ── Registre foncier : enrichissement payant (25 points de scoring) ──────────
# fonciq — registre foncier + Infolot + rôles consolidés.
# Inscription gratuite avec 5 crédits : https://fonciq.ca
# API v1 annoncée pour partenaires pilotes — écrire pour l'accès.
# FONCIQ_API_KEY=
# FONCIQ_BASE_URL=https://api.fonciq.ca/v1

# JLR (Equifax) — requis pour la recherche INVERSÉE de préavis d'exercice par
# territoire, que le registre public ne permet pas. URL fournie à l'entente.
# JLR_API_KEY=
# JLR_BASE_URL=

# ── Garde-fous budgétaires (limites DURES, en dollars) ───────────────────────
# FONCIER_BUDGET_PASSE=25
# FONCIER_BUDGET_MENSUEL=200
# FONCIER_COUT_UNITAIRE=2.50

# ── Alertes Centris (côté « déjà à vendre ») ─────────────────────────────────
# Aucune extraction du site : Centris pousse les fiches par courriel via une
# alerte de recherche sauvegardée, et l'agent lit ces courriels dans Gmail.
# Réutilise GOOGLE_OAUTH_JSON — rien de plus à configurer côté Google.
#
# Expéditeurs des alertes, séparés par des virgules. Ajuster si les courriels
# arrivent d'un domaine d'infolettre plutôt que de centris.ca directement.
# CENTRIS_EXPEDITEURS=centris.ca

# ── Interface web de prospection ─────────────────────────────────────────────
# Servie à https://<ton-domaine>/foncier/
# Réutilise DASHBOARD_SECRET s'il existe ; sinon WEBHOOK_SECRET. Sans aucun
# secret configuré, l'interface est OUVERTE — à ne pas laisser ainsi en ligne.
# FONCIER_SECRET=

# ── Ingestion en un coup ─────────────────────────────────────────────────────
# Rôles d'évaluation à charger par `python dispatch.py foncier ingerer`.
# URLs ou chemins locaux, séparés par des virgules. Préférer le GÉORÉFÉRENCÉ
# (GeoJSON) : sans coordonnées, ni la carte ni les signaux TOD/PPU ne marchent.
# FONCIER_ROLES=data/role-montreal.geojson,data/role-longueuil.geojson

# Registre local des MRC, étendu par `foncier mrc --ajouter`.
# FONCIER_MRC_FICHIER=./data/foncier/mrc.json
